# Wedding invitation — environment example
#
# Copy to `.env.local` (git-ignored) only if you need to override a default.
# Nothing here is required to build or deploy: the site already points at the
# deployed RSVP API, and no secret belongs in this project — the browser talks
# to the API, never to MongoDB.

# Where the RSVP form sends a reply. Defaults to the deployed API:
#   https://twiller-2-0-92g7.onrender.com
# Set it to a local backend while developing:
#   VITE_RSVP_API_URL=http://localhost:5000
VITE_RSVP_API_URL=
